{
  // nav2lint tasks for VS Code. Copy this file to <your workspace>/.vscode/tasks.json.
  //
  // - "nav2lint: check current file": run from the Command Palette (Tasks: Run Task) or bind a key.
  // - "nav2lint: watch workspace": starts when the folder opens and re-checks every Nav2 parameter
  //   file under the workspace on each save. VS Code asks once whether to allow automatic tasks.
  //
  // Findings appear as squiggles in the YAML and in the Problems panel (Ctrl+Shift+M).
  // Set your ROS 2 distro in a .nav2lint.yaml at the workspace root (`distro: humble`), and change
  // the paths below if nav2lint does not live in D:/projects/nav2lint.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nav2lint: check current file",
      "type": "process",
      "windows": { "command": "D:/projects/nav2lint/.venv/Scripts/python.exe" },
      "linux": {
        "command": "python3",
        "options": { "env": { "PYTHONPATH": "/mnt/d/projects/nav2lint/src" } }
      },
      "args": ["-m", "nav2lint", "--format", "line", "${file}"],
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "nav2lint",
        "source": "nav2lint",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+): (error|warning|info)\\[(\\w+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "nav2lint: watch workspace",
      "type": "process",
      "windows": { "command": "D:/projects/nav2lint/.venv/Scripts/python.exe" },
      "linux": {
        "command": "python3",
        "options": { "env": { "PYTHONPATH": "/mnt/d/projects/nav2lint/src" } }
      },
      "args": ["-m", "nav2lint", "--watch", "--format", "line", "${workspaceFolder}"],
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "never" },
      "problemMatcher": {
        "owner": "nav2lint",
        "source": "nav2lint",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+): (error|warning|info)\\[(\\w+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeBegin": true,
          "beginsPattern": "^nav2lint: checking",
          "endsPattern": "^nav2lint: done"
        }
      }
    }
  ]
}
