{
  // nav2lint tasks for VS Code. Copy this file to <your workspace>/.vscode/tasks.json.
  //
  // - "nav2lint: check current file": run from the Command Palette (Tasks: Run Task) or bind a key.
  // - "nav2lint: watch workspace": start manually with Tasks: Run Task to re-check Nav2 parameter
  //   files after changes. Automatic folder-open tasks are not enabled; opt in explicitly if wanted.
  //
  // Install nav2lint in the Python environment used by "python" on PATH, or change both commands
  // to that environment's Python executable (use "python3" if needed on your platform).
  // A process task does not automatically use the Python extension's selected interpreter or
  // python.defaultInterpreterPath setting. Use an explicit executable to select an environment.
  // Findings appear as squiggles in the YAML and in the Problems panel (Ctrl+Shift+M).
  // Set your ROS 2 distro in a .nav2lint.yaml at the workspace root (`distro: humble`).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nav2lint: check current file",
      "type": "process",
      "command": "python",
      "options": { "cwd": "${workspaceFolder}" },
      "args": ["-m", "nav2lint", "--format", "line", "${file}"],
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "nav2lint",
        "source": "nav2lint",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+): (error|warning|info)\\[(\\w+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "nav2lint: watch workspace",
      "type": "process",
      "command": "python",
      "options": { "cwd": "${workspaceFolder}" },
      "args": ["-m", "nav2lint", "--watch", "--format", "line", "${workspaceFolder}"],
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "problemMatcher": {
        "owner": "nav2lint",
        "source": "nav2lint",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+): (error|warning|info)\\[(\\w+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeBegin": true,
          "beginsPattern": "^nav2lint: checking",
          "endsPattern": "^nav2lint: done"
        }
      }
    }
  ]
}
